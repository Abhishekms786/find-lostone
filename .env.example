# =====================================================
# FindIt – Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# Flask secret key (change to a random long string in production)
SECRET_KEY=change-me-to-a-very-long-random-secret-key-123456

# MongoDB connection string from MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=findit_db

# Admin account (created automatically on first startup)
ADMIN_EMAIL=admin@findit.edu
ADMIN_PASSWORD=Admin@1234

# Flask environment (set to False in production)
FLASK_DEBUG=True

# Port (used on platforms like Render)
PORT=5000
